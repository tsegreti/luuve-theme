{% comment %}
    Render Testimonial card

    Accepts:
    - block:     {Object}
{% endcomment %}
<li class="testimonial{% unless section.settings.appearence == 'grid' %} slider__slide{% endunless %} reveal-item">
    {% if section.settings.show_product_info %}
        <div class="product-info">
            <div class="product-image media">
                {%- if block.settings.product_image != blank %}
                    <img
                        src="{{ block.settings.product_image | image_url }}"
                        alt="{{ 'sections.testimonials.no_testimonials.image_alt' | t: image: product }}"
                        loading="lazy"
                    >
                {% else %}
                    {{ 'collection-6' | placeholder_svg_tag: 'placeholder' }}
                {% endif %}
            </div>
            {% if section.settings.show_product_title %}
                <div class="title-container">
                    <p class="product-title">{{ block.settings.product_title }}</p>
                </div>
            {% endif %}
        </div>
    {% endif %}
    <div class="testimonial-inner">
        {% capture customer_image_html %}
            {% if section.settings.show_photo %}
                <div class="photo media">
                    {%- if block.settings.customer_image != blank %}
                        <img src="{{ block.settings.customer_image | image_url }}"
                            alt="{{ 'sections.testimonials.no_testimonials.photo_alt' | t: name: name }}"
                            loading="lazy"
                        />
                    {% endif %}
                    {% if block.settings.customer_image == blank %}
                        <svg class="placeholder" aria-hidden="true" focusable="false">
                            <use href="#person-{{ section.id }}"></use>
                        </svg>
                    {% endif -%}
                </div>
            {% endif %}
        {% endcapture %}
        {% if section.settings.card_design == 'grid' %}
            {{ customer_image_html -}}
        {%- endif %}
        <div class="text rte">
            {% if section.settings.show_rating %}
                <div class="rating">
                    {% for i in (1..5) %}
                        <svg
                            {% if block.settings.rating > forloop.index0 %}
                                class="active"
                            {% endif %}
                            aria-hidden="true"
                            focusable="false"
                            width="14"
                            height="13"
                        >
                            <use href="#star-{{ section.id }}"></use>
                        </svg>
                    {% endfor %}
                </div>
            {% endif %}
            {%- if block.settings.testimonial_title != blank %}
                <div>
                    <p class="testimonial-title">
                        &ldquo;
                        {{- block.settings.testimonial_title -}}
                        &rdquo;
                    </p>
                    <p class="testimonial-text">
                        {{- block.settings.testimonial -}}
                    </p>
                </div>
            {% else %}
                &ldquo;{{ block.settings.testimonial }}&rdquo;
            {% endif -%}
        </div>
        <div class="author-info">
            {% if section.settings.card_design == 'list' %}
                {{ customer_image_html }}
            {% endif %}
            <div>
                <p class="author">{{ block.settings.author_name }}</p>
                <p class="location">{{ block.settings.location }}</p>
                {% if section.settings.show_date %}
                    <p class="date">{{ block.settings.date }}</p>
                {% endif %}
            </div>
        </div>
    </div>
</li>
