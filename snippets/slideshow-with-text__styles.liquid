{%- liquid
    assign media_condition = 'all'
    if section.settings.visibility == 'mobile'
        assign media_condition = '(max-width: 639px)'
    elsif section.settings.visibility == 'desktop'
        assign media_condition = '(min-width: 640px)'
    endif
-%}

<style media="{{ media_condition }}">
    #shopify-section-{{ section.id }} {
    	display: block;
    }

    .slideshow-with-text {
    	display: flex;
    	flex-direction: column;
    }

    #shopify-section-{{ section.id }} .slideshow-with-text:is(.layout-text_first) {
    	flex-direction: column-reverse;
    }

    .slideshow-with-text ul.slider {
    	align-items: center;
    }

    .slideshow-with-text .content-wrapper {
    	display: flex;
    	flex-direction: column;
    	padding: 2rem;
    }

    #shopify-section-{{ section.id }} .content-wrapper:is(.text_position--start) {
    	justify-content: flex-start;
    }

    #shopify-section-{{ section.id }} .content-wrapper:is(.text_position--center) {
    	justify-content: center;
    }

    #shopify-section-{{ section.id }} .content-wrapper:is(.text_position--end) {
    	justify-content: flex-end;
    }

    #shopify-section-{{ section.id }} .content-wrapper:is(.text_align--left) {
    	text-align: left;
    	align-items: flex-start;
    }

    #shopify-section-{{ section.id }} .content-wrapper:is(.text_align--center) {
    	text-align: center;
    }

    #shopify-section-{{ section.id }} .content-wrapper:is(.text_align--right) {
    	text-align: right;
    	align-items: flex-end;
    }

    .slideshow-with-text :is(.slider-buttons) {
    	width: 100%;
    	position: absolute;
    	top: 50%;
    	transform: translateY(-50%);
    }

    .slideshow-with-text :is(.slider-buttons) button {
    	position: absolute;
    	background: rgba(255,255,255, .5) !important;
    }

    .slideshow-with-text :is(.slider-buttons) button[name="next"] {
    	right: 0;
    }

    .slideshow-with-text :is(.slider-buttons) button[name="previous"] {
    	left: 0;
    }

    @media(min-width: 990px) {
    	#shopify-section-{{ section.id }} .slideshow-with-text:is(.layout-image_first) {
    		flex-direction: row;
    	}

    	#shopify-section-{{ section.id }} .slideshow-with-text:is(.layout-text_first) {
    		flex-direction: row-reverse;
    	}

    	.slideshow-with-text > div {
    		width: 50%;
    	}

    	#shopify-section-{{ section.id }} .slideshow-with-text:is(.layout-zigzag) > div:first-child {
    		margin-top: 30px;
    		margin-bottom: -30px;
    	}
    }
</style>
