{%- comment -%}
    Render Video styles

    Accepts:
    - media:        {String}
{%- endcomment -%}

<style media="{{ media }}">
    #shopify-section-{{ section.id }} {
        display: block;
    }
    .video-section :is(.content-wrapper) {
        position: absolute;
    }
    #shopify-section-{{ section.id }} .content-wrapper {
        padding: 0.5rem 1rem;
    }
    @media screen and (min-width: 768px) {
        #shopify-section-{{ section.id }} .content-wrapper {
            padding: 2rem;
        }
        #shopify-section-{{ section.id }} .content-wrapper:is(._center) {
            left: 50%;
            transform: translateX(-50%);
        }
        #shopify-section-{{ section.id }} .content-position-top {
            top: 0;
        }
        #shopify-section-{{ section.id }} .content-position-top:is(._left) {
            left: 0;
        }
        #shopify-section-{{ section.id }} .content-position-top:is(._right) {
            right: 0;
        }
        #shopify-section-{{ section.id }} .content-position-bottom {
            bottom: 0;
        }
        #shopify-section-{{ section.id }} .content-position-bottom:is(._left) {
            left: 0;
        }
        #shopify-section-{{ section.id }} .content-position-bottom:is(._right) {
            right: 0;
        }
    }
    @media screen and (min-width: 990px) {
        #shopify-section-{{ section.id }} .content-wrapper {
            max-width: {{ section.settings.content_max_width }}%;
        }

        #shopify-section-{{ section.id }} :is(.content-position-top) {
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
    }
    @media screen and (min-width: 1440px) {
        #shopify-section-{{ section.id }} .content-wrapper {
            padding: 3rem;
        }
    }
</style>
