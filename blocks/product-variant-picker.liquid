{%- liquid
    assign product = section.settings.product | default: product
    assign block_index = block.settings.block_order
-%}
{%- render 'product__info-block--variant_picker',
    block: block,
    product: product,
    blockOrder: block_index,
    sectionId: section.id
-%}
{% schema %}
{
    "name": "t:sections.main-product.blocks.variant_picker.name",
    "tag": null,
    "settings": [
        {
            "type": "select",
            "id": "picker_type",
            "options": [
                {
                    "value": "dropdown",
                    "label": "t:sections.main-product.blocks.variant_picker.settings.picker_type.options__1.label"
                },
                {
                    "value": "button",
                    "label": "t:sections.main-product.blocks.variant_picker.settings.picker_type.options__2.label"
                }
            ],
            "default": "button",
            "label": "t:sections.main-product.blocks.variant_picker.settings.picker_type.label"
        },
        {
            "type": "checkbox",
            "id": "mark_unavailable_variants",
            "label": "t:sections.main-product.blocks.variant_picker.settings.mark_unavailable_variants.label",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "show_swatch_colors",
            "default": true,
            "label": "t:sections.main-product.blocks.variant_picker.settings.show_swatch_colors.label"
        },
        {
            "type": "header",
            "content": "t:sections.all.advanced.header.content"
        },
        {
            "type": "number",
            "id": "block_order",
            "label": "t:sections.all.advanced.block_order.label",
            "info": "t:sections.all.advanced.block_order.info",
            "default": 6
        }
    ],
    "presets": [
        {
            "name": "t:sections.main-product.blocks.variant_picker.name",
            "category": "t:sections.all.categories.product-information"
        }
    ]
}
{% endschema %}
