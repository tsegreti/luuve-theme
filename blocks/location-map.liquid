<div class="contact map__location" {{ block.shopify_attributes }}>
    {%- assign api_key = block.settings.api_key | escape -%}
    {%- if api_key != blank -%}
        {%- assign coordinate_latitud = block.settings.position_latitude | escape -%}
        {%- assign coordinate_longitud = block.settings.position_longitude | escape -%}
        {%- assign street = block.settings.street_address | escape -%}
        {%- assign postcode = block.settings.postcode | escape -%}
        {%- assign city = block.settings.city | escape -%}
        {%- assign region = block.settings.region_id | escape -%}
        {%- assign country = block.settings.country_id | escape -%}
        {%- assign phone = block.settings.phone | escape -%}
        {%- assign email = block.settings.email | escape -%}
        {%- assign shop_name = shop.name | escape -%}
        <div class="error_coordinates" hidden>
            <p>{{ 'templates.contact.location.error_coordinates' | t }}</p>
        </div>
        <div id="map"></div>
        {% render 'init_map_js',
            api_key: api_key,
            latitud: coordinate_latitud,
            longitud: coordinate_longitud,
            street: street,
            postcode: postcode,
            city: city,
            region: region,
            country: country,
            phone: phone,
            email: email,
            shop_name: shop_name
        %}
    {%- else -%}
        {%- if template == 'index' %}
            <img src="{{ 'map.svg' | asset_url }}" loading="lazy" class="location-map" width="1440" height="547">
        {% else %}
            {% render 'icon-map-location' %}
        {% endif %}
    {%- endif -%}
</div>

{% style %}
    .map__location { display: block; }
    .map__location > :is(svg, img) {margin: 0 auto;}
{% endstyle %}

