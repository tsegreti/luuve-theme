{%- liquid
    assign product = section.settings.product | default: product
    assign block_index = block.settings.block_order
-%}
{%- render 'product__info-block--custom_liquid',
    block: block,
    product: product,
    blockOrder: block_index,
    sectionId: section.id
-%}
{% schema %}
{
    "name": "t:sections.main-product.blocks.custom_liquid.name",
    "tag": null,
    "settings": [
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "t:sections.main-product.blocks.custom_liquid.settings.heading",
            "default": "Custom Liquid"
        },
        {
            "type": "liquid",
            "id": "custom_liquid",
            "label": "t:sections.main-product.blocks.custom_liquid.settings.custom_liquid"
        },
        {
            "type": "header",
            "content": "t:sections.all.advanced.header.content"
        },
        {
            "type": "number",
            "id": "block_order",
            "label": "t:sections.all.advanced.block_order.label",
            "info": "t:sections.all.advanced.block_order.info",
            "default": 20
        }
    ],
    "presets": [
        {
            "name": "t:sections.main-product.blocks.custom_liquid.name",
            "category": "t:sections.all.categories.product-information"
        }
    ]
}
{% endschema %}
