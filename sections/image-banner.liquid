{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
<noscript>{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
    assign padding_bottom = '56.25%'
    if section.settings.image != blank and section.settings.image_height == 'adapt'
        capture padding_bottom
            render 'helper__media-padding-bottom', image: section.settings.image, image_ratio: 'native'
        endcapture
    endif

    case section.settings.image_height
        when 'small'
            assign padding_bottom = '14rem'
            assign padding_bottom_md = '26rem'
        when 'medium'
            assign padding_bottom = '20rem'
            assign padding_bottom_md = '34rem'
        when 'large'
            assign padding_bottom = '28rem'
            assign padding_bottom_md = '44rem'
    endcase

    assign is_two_images = false
    if section.settings.image != blank and section.settings.image_2 != blank
        assign is_two_images = true
    endif

    if section.settings.full_width
        assign sizes = '100vw'
        assign widths = '742,990,1920,#iw#'
    else
        assign sizes = 'calc(min(100vw, 1200px) - .75rem * 2)'
        assign widths = '698,966,1176,#iw#'
    endif

    assign source = section.settings.source
    assign sourceCount = source.count
    # render random products if sourceCount equals 0
    # if sourceCount == 0
    # capture handels
    # render 'helper__get-similar-products' product: product
    # endcapture
    # assign source = handels | split: '|'
    # assign sourceCount = source.size
    # endif

    assign bannerClass = 'banner'
    if sourceCount > 0
        assign bannerClass = 'banner_with-products'
    endif

    if section.settings.full_width
        assign bannerClass = bannerClass | append: ' full--width'
    else
        assign bannerClass = bannerClass | append: ' dynamic-page-width'
    endif

    if section.settings.stack_images_on_mobile and section.settings.image_2 != blank
        assign bannerClass = bannerClass | append: ' banner--stacked'
    endif

    if section.settings.animation_on_reveal
        assign bannerClass = bannerClass | append: ' reveal-slide-in'
    endif

    assign bannerClass = bannerClass | append: ' banner--' | append: section.settings.image_height

    if section.settings.enable_grayscale_effect
        assign bannerClass = bannerClass | append: ' with--grayscale-effect'
    endif

    assign hotspots = section.blocks | where: 'type', 'hotspot'

    assign media_condition = 'all'
    if section.settings.visibility == 'mobile'
        assign media_condition = '(max-width: 639px)'
    elsif section.settings.visibility == 'desktop'
        assign media_condition = '(min-width: 640px)'
    endif

    assign heading_block = section.blocks | where: 'type', 'heading' | first

    assign align = 'center'
    assign justify = 'center'
    if section.settings.text_box_position contains 'justify-'
        assign justify = section.settings.text_box_position | remove: 'justify-'
    endif

    case section.settings.text_box_position
        when 'top-left'
            assign align = 'flex-start'
            assign justify = 'flex-start'
        when 'top-right'
            assign align = 'flex-start'
            assign justify = 'flex-end'
        when 'bottom-left'
            assign align = 'flex-end'
            assign justify = 'flex-start'
        when 'bottom-right'
            assign align = 'flex-end'
            assign justify = 'flex-end'
        when 'flex-start', 'center', 'flex-end'
            assign align = section.settings.text_box_position
    endcase
-%}

{% style %}
    #shopify-section-{{ section.id }} {
      display: none;
    }
{% endstyle %}
<style media="{{ media_condition }}">
    #shopify-section-{{ section.id }} {
      display: block;
    }
    #Banner-{{ section.id }} .banner__media {
      padding-bottom: {{ padding_bottom }};
    }
    {% unless section.settings.image_position == 'center' %}
    #Banner-{{ section.id }} .banner__media > * {
      object-position: {{ section.settings.image_position }};
    }{% endunless %}

    #Banner-{{ section.id }} .banner__content {
      align-items: {{ align }};
      justify-content: {{ justify }};
    }

    #Banner-{{ section.id }} .banner__heading {
      font-size: 2.5rem;
      font-family: var(--font-heading-family);
    }

    #Banner-{{ section.id }} .banner__box {
        display: flex;
        flex-direction: column;
        align-items: {{ section.settings.text_box_content_alignment }};
        text-align: {{ section.settings.text_box_content_alignment | replace: "flex-", ""}};
      }

    {% unless hotspots.size == 0 %}
      #Banner-{{ section.id }} .hotspot-link {
        position: absolute;
        display: flex;
        align-items: center;
        justify-content:center;
        border-radius: 9999px;
        width: 2rem;
        height: 2rem;
        z-index: 1;
      }
    {% endunless %}{% if section.settings.image_height != 'adapt' %}

    @media (min-width: 768px) {
      #Banner-{{ section.id }} .banner__media {
        padding-bottom: {{ padding_bottom_md }};
      }
    }{% endif %}

    @media (min-width: 990px) {
      .separated_box_content {
        position: absolute;
        width: 50%;
        top: 0;
        height: 100%;
      }

      .separated_box_content > div {
        display: flex;
        flex-direction: column;
        height: 100%;
        justify-content: space-around;
      }
      #Banner-{{ section.id }} .separated_box_content {
      {% case section.settings.text_box_position %}
        {% when 'justify-start' %}
          right: 2rem;
        {% when 'justify-end' %}
          left: 2rem;{% endcase %}
      }
      {% if section.settings.underlayer %}
      #Banner-{{ section.id }} {
        padding: 2.5rem;
      }

      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }}::after {
        background: var(--color-foreground-4);
        content: '';
        left: 0;
        top: 0;
        width: 40%;
        bottom: 5rem;
        position: absolute;
        z-index: -1;
      }

      #Banner-{{ section.id }}::after {
        left: auto;
        right: 0;
        bottom: 0;
        top: 5rem;
      }{% endif %}

      @media (min-width: 1300px) {
        #Banner-{{ section.id }} .separated_box_content {
        {% case section.settings.text_box_position %}
          {% when 'justify-start' %}
            right: 6rem;
          {% when 'justify-end' %}
            left: 6rem;{% endcase %}
        }
      }
    }
</style>

{% unless sourceCount == 0 %}
    {%- style -%}
        #shopify-section-{{ section.id }} .banner_with-products {
            position: relative;
            display: flex;
            flex-direction: column;
        }
        #shopify-section-{{ section.id }} .highlight-products {
            width: 100%;
            border-radius: 2px;
        }
        {% if section.settings.separate_desription_with_products %}
        #shopify-section-{{ section.id }} .highlight-products {
            max-width: calc(400px + 2rem);
        }

        #shopify-section-{{ section.id }} .highlight-products .item-actions-wrapper {
            position: unset;
        }{% else %}

        #shopify-section-{{ section.id }} .highlight-products {
            max-width: calc(520px - 4px);
        }

        #shopify-section-{{ section.id }} .highlight-products .item-actions-wrapper {
            bottom: 0;
            right: unset;
            top: unset;
            left: 50%;
            transform: translateX(-50%);
        }{% endif %}

        .highlight-products ul > li {
            display: flex;
            flex-direction: column;
        }

        .highlight-products ul > li > div {
            text-align: center;
        }
        {% if section.settings.separate_desription_with_products %}
        #shopify-section-{{ section.id }} .highlight-products .item-actions-wrapper {
            background: {{ section.settings.bg_color_2 }};
            padding: 2rem;
        }

        #shopify-section-{{ section.id }} .highlight-products .slider-buttons {
            justify-content: space-around;
        }
        #shopify-section-{{ section.id }} .highlight-products .slider-buttons svg {
            color: var(--color-foreground);
        }
        {% endif %}
        #shopify-section-{{ section.id }} .highlight-products .item-actions-wrapper .message-wrapper {
            position: absolute;
            bottom: 100%;
        }

        .highlight-products .item-actions-wrapper .button {
            padding: .5rem 2.5rem;
            opacity: 1;
            transform: none;
        }

        .highlight-products .icon-cart {
            display: none;
        }
        {% unless section.settings.separate_desription_with_products %}
        #shopify-section-{{ section.id }} .highlight-products slider-component {
            background: {{ section.settings.bg_color_2 }};
        }
        {% endunless %}
        {% unless hotspots.size == 0 %}
        hotspots .hotspot-tooltip:not(.active) {
            opacity: 0;
        }{% endunless %}

        @media (max-width: 500px) {
            #shopify-section-{{ section.id }} :is(.separated_box_content),
            #shopify-section-{{ section.id }} .highlight-products .content-wrapper {
                background: {{ section.settings.bg_color_1 }};
                padding: 2rem 1rem;
            }
            {% unless section.settings.separate_desription_with_products %}
            .highlight-products ul > li a {
                margin: 1rem 0rem 5rem;
            }

            .highlight-products slider-component {
                margin-top: 2.5rem;
                padding: 2rem;
            }
            {% endunless %}
            .highlight-products .title {
                font-size: 2.25rem;
            }

            .highlight-products .slider-buttons {
                margin-top: 1rem;
            }

            {% if section.settings.hide_banner_on_mobile %}
            #shopify-section-{{ section.id }} .banner__media {
                display: none;
            }{% endif %}
        }

        @media (min-width: 767px) {
            #shopify-section-{{ section.id }} .highlight-products {
                position: absolute;
                top: 0;
            }

            #shopify-section-{{ section.id }} .highlight-products.left {
                left: 1rem;
            }

            #shopify-section-{{ section.id }} .highlight-products.right {
                right: 1rem;
            }

            .highlight-products .grid-item .item-link {
                border: 0;
            }
            {% unless section.settings.image_2 == blank %}
            #shopify-section-{{ section.id }} .banner_with-products {
                flex-direction: unset;
            }{% endunless %}

            #shopify-section-{{ section.id }} .highlight-products.left {
                left: 1rem;
            }

            #shopify-section-{{ section.id }} .highlight-products.right {
                right: 1rem;
            }
            {% if section.settings.separate_desription_with_products %}
            #shopify-section-{{ section.id }} .highlight-products {
                top: 50%;
                transform: translateY(-50%);
            }
            {% else %}
            .highlight-products ul > li {
                padding: 2rem 4rem 4rem;
            }

            .highlight-products ul > li a {
                margin: 1rem 2.5rem 2.5rem;
            }

            #shopify-section-{{ section.id }} .highlight-products .item-actions-wrapper {
                bottom: 2rem;
            }
            {% endif %}
            {% unless section.settings.separate_desription_with_products %}
            .highlight-products .slider-buttons .slider__button {
                position: absolute;
                top: 50%;
                transform: translateY(-50%);
                z-index: 11;
            }
            {% endunless %}
            .highlight-products .slider-buttons .slider-button--prev {
                left: .25rem;
            }

            .highlight-products .slider-buttons .slider-button--next {
                right: .25rem;
            }

            .highlight-products .slider-counter {
                display: none;
            }
        }
        {% if section.settings.separate_desription_with_products %}
        @media (min-width: 1300px) {
            #shopify-section-{{ section.id }} .highlight-products.left {
                left: 6rem;
            }

            #shopify-section-{{ section.id }} .highlight-products.right {
                right: 6rem;
            }
        }{% endif %}
    {%- endstyle -%}
{% endunless %}

{% capture bannerBoxContent %}
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'heading' -%}
      {% if block.settings.heading_font_size > 0 %}
        <style>
          @media(min-width: 990px) {            
            #Banner-{{ section.id }} .banner__heading {
              font-size:{{ block.settings.heading_font_size }}rem;
            }
          }
        </style>
        {% endif %}
        <span class="banner__heading reveal-item{% unless block.settings.heading_font_size > 0 %} {{ block.settings.level }}{% endunless %}" style="color: {{ block.settings.heading_color }};" {{ block.shopify_attributes }}>
          <span>{{ block.settings.heading }}</span>
        </span>
      {%- when 'text' -%}
        {% unless block.settings.text == blank %}
        <div class="banner__text rte reveal-item" style="color: {{ block.settings.text_color }};font-size: {{ block.settings.text_font_size }}rem;" {{ block.shopify_attributes }}>
          {{ block.settings.text }}
        </div>
        {% endunless %}
      {%- when 'buttons' -%}
        {% liquid
            assign btn_class = 'banner__buttons reveal-item'

            if block.settings.button_label_1 != blank and block.settings.button_label_2 != blank
              assign btn_class = btn_class | append: ' banner__buttons--multiple'
            endif

            if block.settings.action_btn_width == 'extend'
              assign btn_class = btn_class | append: ' _extend'
            endif
         %}
        <div class="{{ btn_class }}" {{ block.shopify_attributes }}>
          {%- if block.settings.button_label_1 != blank -%}
            <a href="{{ block.settings.button_link_1 }}"
              class="button animate-arrow{% if block.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}"
              {% if block.settings.button_link_1 == blank %}aria-disabled="true"{% endif %}
            >
              {{ block.settings.button_label_1 | escape }}
              {%- if settings.current_theme_icons == 'enduro' %}
                {%- render 'icons-solid-enduro', name: 'arrow-right', css_class: 'icon icon-arrow' -%}
              {% else %}
                {% render 'icons-solid', name: 'long-arrow-right', css_class: 'icon-arrow extend' %}
              {% endif -%}
            </a>
          {%- endif -%}
          {%- if block.settings.button_label_2 != blank -%}
            <a href="{{ block.settings.button_link_2 }}"
              class="button animate-arrow{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
              {% if block.settings.button_link_2 == blank %} aria-disabled="true"{% endif %}
            >
              {{ block.settings.button_label_2 | escape }}
              {%- if settings.current_theme_icons == 'enduro' %}
                {%- render 'icons-solid-enduro', name: 'arrow-right', css_class: 'icon icon-arrow' -%}
              {% else %}
                {% render 'icons-solid', name: 'long-arrow-right', css_class: 'icon-arrow extend' %}
              {% endif -%}
            </a>
          {%- endif -%}
        </div>
        {%- when 'collections' -%}
          {% liquid
            assign collection__class = 'banner__collections-list reveal-item'
            if block.settings.enable_animation
              assign collection__class = collection__class | append: ' with-animation'
            endif

            if block.settings.enable_bold_font
              assign collection__class = collection__class | append: ' bold-font'
            endif

            assign collections_source = blank

            if block.settings.use_collection_metafields
              assign metafield_name = block.settings.metafield_name 
              assign collections_source = collection.metafields['custom'][metafield_name].value
            else
              assign collections_source = block.settings.collections_list
            endif
          %}

          {% if collections_source != blank %}
            <ul class="{{collection__class}}" {{ block.shopify_attributes }}>
              {% if block.settings.enable_view_all and block.settings.view_all_link != blank %}
                <li>
                  <a class="banner__collections-item" style="color: {{ block.settings.collection_item_color }}; font-size: {{ block.settings.collection_item_font_size }}rem" href="{{ block.settings.view_all_link | escape }}">{{  block.settings.view_all_text }}</a>
                </li>
              {% endif %}
              {%- for item in collections_source -%}
                <li>
                  <a class="banner__collections-item" style="color: {{ block.settings.collection_item_color }}; font-size: {{ block.settings.collection_item_font_size }}rem" href="{{ item.url }}">{{ item.title }}</a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
    {%- endcase -%}
  {%- endfor -%}
{% endcapture %}

<div id="Banner-{{ section.id }}" class="{{ bannerClass }}">
    {% if section.settings.image_parallax_speed > 0 %}
        <parallax-component
            class="banner__media media{% if section.settings.image_2 != blank %} banner__media-half{% endif %}"
            data-speed="{{ section.settings.image_parallax_speed | times: 0.01 }}"
            data-original-object-position="{{ section.settings.image_position }}"
        >
    {% else %}
        <div class="banner__media media{% if section.settings.image_2 != blank %} banner__media-half{% endif %}">
    {% endif %}
    {% if collection.image != blank %}
        {% render 'render-image',
            image: collection.image,
            width: collection.image.width,
            widths: widths,
            sizes: sizes,
            is_preload: section.settings.is_preload
        %}
    {% else %}
        {% if section.settings.image != blank %}
            {% render 'render-image',
                image: section.settings.image,
                width: section.settings.image.width,
                widths: widths,
                sizes: sizes,
                is_preload: section.settings.is_preload
            %}
        {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
        {% endif %}
    {% endif %}

    {% comment %} hotspots html {% endcomment %}
    {% unless hotspots.size == 0 %}
        {% render 'hotspots', hotspots: hotspots, products: source %}
    {% endunless %}
    {% if section.settings.image_parallax_speed > 0 %}</parallax-component>{% else %}</div>{% endif %}
    {%- if section.settings.image_2 != blank -%}
        <div class="banner__media media banner__media-half">
            {% render 'render-image',
                image: section.settings.image_2,
                width: section.settings.image_2.width,
                widths: widths,
                sizes: sizes,
                is_preload: section.settings.is_preload
            %}
        </div>
    {%- endif -%}
    <div class="banner__content{% unless sourceCount == 0 %} with-highlight-products{% endunless %}">
        {%- if sourceCount == 0 -%}
            <div class="banner__box color-{{ section.settings.color_scheme }}">
                {{- bannerBoxContent -}}
            </div>
        {%- endif -%}

        {%- unless sourceCount == 0 -%}
            {%- liquid
                assign boxPosition = section.settings.text_box_position
                assign box_position = 'right'
                if boxPosition == 'justify-start' or boxPosition == 'flex-start'
                    assign box_position = 'left'
                endif
            -%}
            {%- render 'highlight-products',
                items_candidate: source,
                box_position: box_position,
                heading_block: heading_block,
                separate_desription_with_products: section.settings.separate_desription_with_products
            -%}
        {%- endunless -%}
        {% if section.settings.separate_desription_with_products %}
            {%- unless sourceCount == 0 -%}
                <div class="separated_box_content">
                    <div class="wrapper">
                        {{- bannerBoxContent -}}
                    </div>
                </div>
            {%- endunless -%}
        {% endif %}
    </div>
</div>

{%- if section.settings.image_parallax_speed > 0 %}
    <script type="text/init-deferred">
        {
          "parallax": {
            "src": "{{ 'parallax.js' | asset_url }}",
            "reveal": "parallax-component"
          }
        }
    </script>
{% endif -%}

{% schema %}
{
  "name": "t:sections.image-banner.name",
  "tag": "section",
  "class": "spaced-section spaced-section--full-width",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-banner.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "t:sections.image-banner.settings.image_2.label"
    },
    {
      "type": "range",
      "id": "image_parallax_speed",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 0,
      "label": "t:sections.image-banner.settings.image_parallax_speed.label",
      "info": "t:sections.image-banner.settings.image_parallax_speed.info"
    },
    {
      "type": "checkbox",
      "id": "stack_images_on_mobile",
      "default": false,
      "label": "t:sections.image-banner.settings.stack_images_on_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "is_preload",
      "default": false,
      "label": "t:sections.image-banner.settings.is_preload.label",
      "info": "t:sections.image-banner.settings.is_preload.info"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.image-banner.settings.image_position.label",
      "options": [
        {
          "value": "top",
          "label": "t:sections.image-banner.settings.image_position.options.top"
        },
        {
          "value": "center",
          "label": "t:sections.image-banner.settings.image_position.options.center"
        },
        {
          "value": "bottom",
          "label": "t:sections.image-banner.settings.image_position.options.bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_box_position",
      "options": [
        {
          "value": "justify-start",
          "label": "t:sections.image-banner.settings.text_box_position.justify-start.label"
        },
        {
          "value": "flex-start",
          "label": "t:sections.all.alignments.top.label"
        },
        {
          "value": "top-left",
          "label": "t:sections.image-banner.settings.text_box_position.top-left.label"
        },
        {
          "value": "top-right",
          "label": "t:sections.image-banner.settings.text_box_position.top-right.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.alignments.center.label"
        },
        {
          "value": "flex-end",
          "label": "t:sections.all.alignments.bottom.label"
        },
        {
          "value": "bottom-left",
          "label": "t:sections.image-banner.settings.text_box_position.bottom-left.label"
        },
        {
          "value": "bottom-right",
          "label": "t:sections.image-banner.settings.text_box_position.bottom-right.label"
        },
        {
          "value": "justify-end",
          "label": "t:sections.image-banner.settings.text_box_position.justify-end.label"
        }
      ],
      "default": "center",
      "label": "t:sections.image-banner.settings.text_box_position.label"
    },
    {
      "type": "select",
      "id": "text_box_content_alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:sections.image-banner.settings.text_box_content_alignment.options.flex-start.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-banner.settings.text_box_content_alignment.options.center.label"
        },
        {
          "value": "flex-end",
          "label": "t:sections.image-banner.settings.text_box_content_alignment.options.flex-end.label"
        }
      ],
      "default": "center",
      "label": "t:sections.image-banner.settings.text_box_content_alignment.label"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "t:sections.all.colors.accent_1.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.all.colors.accent_2.label"
        },
        {
          "value": "background-1",
          "label": "t:sections.all.colors.background_1.label"
        },
        {
          "value": "background-2",
          "label": "t:sections.all.colors.background_2.label"
        },
        {
          "value": "inverse",
          "label": "t:sections.all.colors.inverse.label"
        }
      ],
      "default": "background-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.image-banner.settings.image_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.image-banner.settings.image_height.options__2.label"
        },
