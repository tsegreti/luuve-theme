{%- liquid
    assign product = section.settings.product
    assign titlePosition = section.settings.heading_position

    # if product == nil and section.settings.use_random_product
    #    assign limit = 1
    #    assign randomProduct = ''
    #    assign count = 0

    #   for collection in collections
    #        for item in collection.products
    #            if item.featured_image and item.variants.size > 1
    #                assign count = count | plus: 1
    #                assign randomProduct = item
    #                if count == limit
    #                    break
    #                endif
    #            endif
    #        endfor
    #        if count == limit
    #            break
    #        endif
    #    endfor
    #    assign product = randomProduct
    # endif

    assign is_thumbs = section.settings.show_thumbnails
    assign __class__ = 'dynamic-page-width'

    if section.settings.full_width
        assign __class__ = 'full--width'
    endif

    assign __class__ = __class__ | append: ' color-' | append: section.settings.color_scheme
    assign __class__ = __class__ | append: ' featured-product'
    unless request.design_mode
        if section.settings.animation_on_reveal
            assign __class__ = __class__ | append: ' reveal-slide-in'
        endif
    endunless

    if section.settings.enable_grayscale_effect
        assign __class__ = __class__ | append: ' with--grayscale-effect'
    endif

    if section.settings.enable_noise_effect
        assign __class__ = __class__ | append: ' with--noise-effect'
    endif

    assign hasGallery = true
    if product == null or product.media.size < 1
        assign hasGallery = false
    endif

    assign product_info_class = 'product__info'
    if hasGallery
        assign product_info_class = product_info_class | append: ' product__info--with-gallery'
    endif

    if section.settings.enable_sticky_info
        assign product_info_class = product_info_class | append: ' product__info--sticky'
    endif

    if section.settings.enable_box_inner_paddings
        assign product_info_class = product_info_class | append: ' with--inner-paddings'
    endif
-%}

{% render 'product__assets' %}

{% style %}
    .featured-product {
        position: relative;{% if section.settings.enable_noise_effect %}
        --image-noise:  url({{'noise3.svg' |  asset_url }});{% endif -%}
    }

    #shopify-section-{{ section.id }} .heading {
        margin-bottom: 2rem;
    }
    #shopify-section-{{ section.id }} .heading-position-{{ titlePosition }} {
        align-items: {{ titlePosition }};
    }
    #shopify-section-{{ section.id }} .heading > .title {
        color: {{ section.settings.heading_foreground }};
    }
    #shopify-section-{{ section.id }} .dynamic-page-width {
        padding-top: 2rem;
        padding-bottom: 2rem;
    }
    #shopify-section-{{ section.id }} .product__view-details {
        background: transparent;
    }
    #shopify-section-{{ section.id }} :is(.with--inner-paddings) {
        padding: 1rem;
        background: {{ section.settings.box_inner_background }};
    }
    {%- unless is_thumbs %}
    #shopify-section-{{ section.id }} slider-vertical .slider-pagination,
    {% endunless -%}
    #shopify-section-{{ section.id }} slider-vertical .image--wrapper .icon-plus {
        display: none;
    }
    @media (max-width: 768px), print {
        #shopify-section-{{ section.id }} .product__view-details {
            margin-top: 1.5rem;
        }
    }
    @media (min-width: 768px), print {
        #shopify-section-{{ section.id }} :is(.with--inner-paddings) {
            padding: 2rem;
        }
    }
{% endstyle %}

<div class="{{ __class__ }}">
    <div class="wrapper dynamic-page-width">
        {%- unless section.settings.heading == blank %}
            <div class="heading heading-position-{{ titlePosition }}">
                <span class="title reveal-item {{ section.settings.heading_size }}">
                    {{ section.settings.heading }}
                </span>
            </div>
        {% endunless -%}
        <div id="ProductInfo-{{ section.id }}" class="{{ product_info_class }}">
            {%-
                content_for 'block',
                type: 'product-media-gallery',
                id: 'media-gallery',
                product: product
            -%}

            <div class="product__info-aside">
                {%- capture product_details %}
                  {% content_for 'block',
                    type: 'product-details',
                    id: 'product-details',
                    product: product                
                  %}
                {% endcapture -%}

                {{- product_details -}}

                <a
                    href="{{ product.url }}"
                    class="button button--tertiary button--small product__view-details animate-arrow"
                    style="order: 99"
                >
                    {{ 'products.product.view_full_details' | t }}

                    {%- if settings.current_theme_icons == 'enduro' %}
                        {%- render 'icons-solid-enduro', name: 'arrow-right', css_class: 'icon icon-arrow' -%}
                    {% else %}
                        {% render 'icons-solid', name: 'long-arrow-right', css_class: 'icon-arrow extend' %}
                    {% endif -%}
                </a>
            </div>
        </div>
    </div>
</div>

{% render 'product__scripts', product: section.settings.product %}

{% schema %}
{
    "name": "t:sections.featured-product.name",
    "tag": "section",
    "class": "spaced-section spaced-section--full-width product-section featured-product-section",
    "settings": [
        {
            "type": "inline_richtext",
            "id": "heading",
            "default": "Featured product",
            "label": "t:sections.featured-product.settings.heading.label"
        },
        {
            "type": "select",
            "id": "heading_size",
            "options": [
                {
                    "value": "h1",
                    "label": "t:sections.featured-product.settings.heading_size.options.h1"
                },
                {
                    "value": "h2",
                    "label": "t:sections.featured-product.settings.heading_size.options.h2"
                },
                {
                    "value": "h3",
                    "label": "t:sections.featured-product.settings.heading_size.options.h3"
                }
            ],
            "default": "h2",
            "label": "t:sections.featured-product.settings.heading_size.label"
        },
        {
            "type": "product",
            "id": "product",
            "label": "t:sections.featured-product.settings.product.label"
        },
        {
            "type": "checkbox",
            "id": "full_width",
            "label": "t:sections.header.settings.full_width.label",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "show_thumbnails",
            "label": "t:sections.featured-product.settings.show_thumbnails.label",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "enable_box_inner_paddings",
            "label": "t:sections.all.settings.enable_box_inner_paddings.label",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "enable_grayscale_effect",
            "label": "t:sections.all.settings.enable_grayscale_effect.label",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "enable_noise_effect",
            "label": "t:sections.all.settings.enable_noise_effect.label",
            "info": "t:sections.all.settings.enable_noise_effect.info",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "animation_on_reveal",
            "label": "t:sections.all.settings.animation_on_reveal.label",
            "default": true
        },
        {
            "type": "select",
            "id": "color_scheme",
            "options": [
                {
                    "value": "accent-1",
                    "label": "t:sections.all.colors.accent_1.label"
                },
                {
                    "value": "accent-2",
                    "label": "t:sections.all.colors.accent_2.label"
                },
                {
                    "value": "background-1",
                    "label": "t:sections.all.colors.background_1.label"
                },
                {
                    "value": "background-2",
                    "label": "t:sections.all.colors.background_2.label"
                },
                {
                    "value": "inverse",
                    "label": "t:sections.all.colors.inverse.label"
                }
            ],
            "default": "background-1",
            "label": "t:sections.all.colors.label"
        },
        {
            "type": "header",
            "content": "t:sections.featured-product.settings.header__1.content"
        },
        {
            "type": "color",
            "id": "heading_foreground",
            "label": "t:sections.featured-product.settings.heading_position.label",
            "default": "#000000"
        },
        {
            "type": "select",
            "id": "heading_position",
            "label": "t:sections.featured-product.settings.heading_position.label",
            "options": [
                {
                    "value": "start",
                    "label": "t:sections.featured-product.settings.heading_position.options.start"
                },
                {
                    "value": "center",
                    "label": "t:sections.featured-product.settings.heading_position.options.center"
                },
                {
                    "value": "end",
                    "label": "t:sections.featured-product.settings.heading_position.options.end"
                }
            ],
            "default": "start"
        } ,
        {
            "type": "color",
            "id": "box_inner_background",
            "label": "t:sections.featured-product.settings.box_inner_background.label",
            "info": "t:sections.featured-product.settings.box_inner_background.info"
        }
    ],
    "blocks": [
        {
            "type": "@app"
        }
    ],
    "presets": [
        {
            "name": "t:sections.featured-product.presets.name"
        }
    ]
}
{% endschema %}
