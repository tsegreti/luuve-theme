{%- liquid
    assign has_gallery = true
    if product.media.size < 1
        assign has_gallery = false
    endif

    assign product_info_class = 'product__info'
    if has_gallery
        assign product_info_class = product_info_class | append: ' product__info--with-gallery'
    endif

    if section.settings.enable_grayscale_effect
        assign product_info_class = product_info_class | append: ' with--grayscale-effect'
    endif

    if section.settings.enable_sticky_info
        assign product_info_class = product_info_class | append: ' product__info--sticky'
    endif

    # aside block
    assign aside_block_class = 'product__info-aside'

    if section.settings.center_product_info
        assign aside_block_class = aside_block_class | append: ' product__info-aside-centered'
    endif

    if section.settings.animation_on_reveal
        assign aside_block_class = aside_block_class | append: ' reveal-slide-in'
    endif
-%}

{% render 'product__assets' %}

<div class="dynamic-page-width product-page">
    <div id="has-options" class="message-wrapper" role="alert" hidden>
        <div class="form__message--notice form__message">
            {% render 'icons-outline', name: 'exclamation-circle' %}
            <p class="notice-message">{{ 'products.product.has_options_message' | t }}</p>
        </div>
    </div>
    <div id="ProductInfo-{{ section.id }}" class="{{ product_info_class }}">
        {%- content_for 'block', type: 'product-media-gallery', id: 'media-gallery' -%}

        <div class="{{ aside_block_class }}">
            {%- capture product_details %}
              {%- content_for 'block', type: 'product-details', id: 'product-details' -%}
            {% endcapture -%}

            {{- product_details -}}
        </div>
    </div>

    {%- content_for 'block', type: 'product-form-quick-add', id: 'product-form-quick-add' -%}
</div>

{%- render 'product__scripts', product: product -%}

<script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": {{ product.title | json }},
        "url": {{ shop.url | append: product.url | json }},
        "image": {{ product.featured_image | json }},
        "brand": {
            "@type": "Thing",
            "name": {{ product.vendor | json }}
        },
        "description": {{ product.description | strip_html | truncatewords: 30 | json }},
        "sku": {% for item in product.variants %}{{ item.sku | json }}{% endfor %},
        "barcode": {% for item in product.variants %}{{ item.barcode | json }}{% endfor %},
        "offers": {
            "@type": "AggregateOffer",
            "highPrice": {{ product.price_max | money_without_currency | json }},
            "lowPrice": {{ product.price_min | money_without_currency | json }},
            "offerCount":{{ product.selected_or_first_available_variant.inventory_quantity }},
            "price": {% for item in product.variants %}{{ item.price | money_without_currency | json }}{% endfor %},
            "priceCurrency": "{{ cart.currency.iso_code }}",
            "priceSpecification": [{% for item in product.variants %}{% if item.compare_at_price > item.price %}
                {
                    "@type": "UnitPriceSpecification",
                    "priceType": "https://schema.org/MSRP",
                    "price":{{ item.compare_at_price | money_without_currency | json }},
                    "valueAddedTaxIncluded": {{ cart.taxes_included }}
                },
                {
                    "@type": "UnitPriceSpecification",
                    "priceType": "https://schema.org/SalePrice",
                    "price": {{ item.price | money_without_currency | json }}
                }{% endif%}{% endfor %}
            ],
            "offers": [{% if product.variants.size > 1%}{% for item in product.variants %}
                {
                    "@type": "Offer",
                    "sku": {{ item.sku | json }},
                    "image": {{ item.featured_image | json }},
                    "price": {{ item.price | money_without_currency | json }},
                    "priceCurrency": "{{ cart.currency.iso_code }}",
                    "availability": "http://schema.org/{% if item.available %}InStock{% else %}OutOfStock{% endif %}",
                    "itemCondition": "https://schema.org/NewCondition",
                    "url": {{ shop.url | append: item.url | json }}
                }{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}
            ]
        }
    }
</script>

{% schema %}
{
  "name": "t:sections.main-product.name",
  "tag": "section",
  "class": "product-section spaced-section",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "default": true,
      "label": "t:sections.main-product.settings.enable_sticky_info.label"
    },
    {
      "type": "checkbox",
      "id": "enable_grayscale_effect",
      "label": "t:sections.all.settings.enable_grayscale_effect.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "animation_on_reveal",
      "label": "t:sections.all.settings.animation_on_reveal.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "center_product_info",
      "label": "t:sections.main-product.settings.center_product_info.label",
      "default": false
    }
  ]
}
{% endschema %}
